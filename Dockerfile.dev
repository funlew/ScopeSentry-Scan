# 本地开发镜像：容器内编译 + air 热重载 + delve 远程调试
# 用法见 docs/LOCAL-DEV.md
FROM golang:1.24-bookworm

ARG GOPROXY=https://goproxy.cn,direct
# 固定在 Go 1.24 下可编译的版本，升级前先确认其 go.mod 的 go 指令
ARG AIR_VERSION=v1.61.7
ARG DLV_VERSION=v1.25.2

ENV GOPROXY=${GOPROXY} \
    CGO_ENABLED=0 \
    LANG=C.UTF-8 \
    TZ=Asia/Shanghai

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        unzip \
        tzdata \
        chromium \
        python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo 'Asia/Shanghai' > /etc/timezone

# uro 用于 urlscan 去重；缺失时模块会自动跳过该步骤
RUN pip3 install --break-system-packages --no-cache-dir uro

# 热重载 / 远程调试
# GOSUMDB=off 只作用于本层：这些工具不进项目依赖，避免受 checksum DB 网络影响
RUN GOSUMDB=off GOTOOLCHAIN=local go install github.com/air-verse/air@${AIR_VERSION} \
    && GOSUMDB=off GOTOOLCHAIN=local go install github.com/go-delve/delve/cmd/dlv@${DLV_VERSION} \
    && cp /go/bin/air /usr/local/bin/air \
    && cp /go/bin/dlv /usr/local/bin/dlv

# 截图/报告渲染字体，与线上镜像保持一致
COPY msyh.ttc /usr/share/fonts/

# 预置外置扫描器，容器启动时按架构拷到 /apps/ext（arm64 下不可用，见文档）
COPY tools/linux /opt/tools/linux

COPY build/dev-entrypoint.sh /usr/local/bin/dev-entrypoint.sh
RUN chmod +x /usr/local/bin/dev-entrypoint.sh

WORKDIR /src
EXPOSE 6060 2345

ENTRYPOINT ["/usr/local/bin/dev-entrypoint.sh"]
CMD ["air", "-c", "/src/.air.toml"]
